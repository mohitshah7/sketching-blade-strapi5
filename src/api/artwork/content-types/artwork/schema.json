{
  "kind": "collectionType",
  "collectionName": "artworks",
  "info": {
    "singularName": "artwork",
    "pluralName": "artworks",
    "displayName": "Artwork"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Title": {
      "type": "string"
    },
    "Description": {
      "type": "text"
    },
    "Category": {
      "type": "enumeration",
      "enum": [
        "Digital Art",
        "Traditional Art",
        "Landscape",
        "Character",
        "Fanart",
        "Sketch",
        "Scribble"
      ]
    },
    "mediums": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::medium.medium",
      "mappedBy": "Artworks"
    }
  }
}
